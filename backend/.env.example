# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Replace with your local MongoDB URI or MongoDB Atlas URI
MONGO_URI=mongodb://localhost:27017/delta_healthcare

# JWT Configuration
ACCESS_TOKEN_SECRET=delta_access_token_secret_9988_!
